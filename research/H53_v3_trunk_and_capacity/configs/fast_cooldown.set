# H53 fast cooldown (FC): one GPU, init = a branch point's raw weights. H41 replay machinery, LR started at the trunk's
# stable LR sqrt-scaled to 650 s (4.3e-4 x sqrt(650/3900) = 1.76e-4; invariant to the world size), cosine to 3e-5.
# Launch with train/ops/h41_replay.sh: INIT_FROM=<BP ckpt> RUN_NAME=H53_FC_<seg>_<step>_s<seed> h41_replay.sh $D <cpus> <gpu> FC \
#   seed=<1234|4321> chunk_modes=4,8,16 eval_chunks=8,16 delay_penalty=<trunk value> lr=0.000176 min_lr_ratio=0.1705
# (h41_replay.sh sets: budget_s=650 max_batch=144 warmup=200 total_steps=8000 ema_decay=0.9995; lr / min_lr_ratio overridden here;
#  ckpt_every_steps=1000 ...). Cooldown-recipe arms (CA-KD / CA-MWER / CA-ANCHOR / CA-LS) add only
#  their own pre-registered keys on top, same BP, same seed as the plain FC they are paired with.
chunk_modes=4,8,16
eval_chunks=8,16
lr=0.000176
min_lr_ratio=0.1705
