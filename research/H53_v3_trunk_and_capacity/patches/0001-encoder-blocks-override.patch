diff -ruN a/python/ultra/tests/test_h53_encoder_blocks.py b/python/ultra/tests/test_h53_encoder_blocks.py
--- a/python/ultra/tests/test_h53_encoder_blocks.py	1970-01-01 00:00:00.000000000 +0000
+++ b/python/ultra/tests/test_h53_encoder_blocks.py	2026-11-23 06:57:17.161545931 +0000
@@ -0,0 +1,31 @@
+"""H53: the encoder_blocks override (depth-grown seeds). Default 0 leaves every preset unchanged."""
+from __future__ import annotations
+
+import dataclasses
+
+import pytest
+
+from train.asr import PRESETS
+from train.recipe_opts import check_init_compatible, model_overrides
+from train.trainer import TrainConfig
+
+
+def test_default_is_the_preset_unchanged():
+    for name in ("S", "S_MR", "M_MR", "V2_S"):
+        assert model_overrides(PRESETS[name], TrainConfig()) == PRESETS[name]
+
+
+def test_override_sets_dense_depth_and_accepts_a_grown_seed():
+    dst = model_overrides(PRESETS["S"], TrainConfig(encoder_blocks=24))
+    assert dst.encoder.n_blocks == 24
+    assert dataclasses.replace(dst.encoder, n_blocks=16) == PRESETS["S"].encoder
+    grown_seed_cfg = dataclasses.replace(PRESETS["S"], encoder=dataclasses.replace(PRESETS["S"].encoder,
+                                                                                    n_blocks=24))
+    check_init_compatible(grown_seed_cfg, dst)  # a seed written by h53 grow_depth --blocks 24
+    with pytest.raises(Exception):
+        check_init_compatible(PRESETS["S"], dst)  # a 16-block checkpoint is a different model
+
+
+def test_override_refuses_non_dense():
+    with pytest.raises(ValueError):
+        model_overrides(PRESETS["S_MR"], TrainConfig(encoder_blocks=24))
