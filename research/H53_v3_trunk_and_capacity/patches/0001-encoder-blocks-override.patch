         enc = dataclasses.replace(enc, chunk=cfg.chunk)
     if cfg.left_context:
         enc = dataclasses.replace(enc, left_context=cfg.left_context)
+    if getattr(cfg, "encoder_blocks", 0):  # H53: a depth-grown seed (h53 grow_depth); dense only
+        if enc.family != "dense":
+            raise ValueError(f"encoder_blocks applies to the dense family, not {enc.family}")
+        enc = dataclasses.replace(enc, n_blocks=cfg.encoder_blocks)
     base = dataclasses.replace(base, encoder=enc)
     return dataclasses.replace(base, pred_ctx=cfg.pred_ctx) if cfg.pred_ctx else base
 
