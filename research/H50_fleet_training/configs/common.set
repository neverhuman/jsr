# H50 D-arms: TrainConfig --set values shared by D0 and every D1 island (= TOPOLOGY.md / h50_topo.sh ARGS),
# init --init-from $D/seeds/H41/model-00060000.pt (sha256 d12336677f3946d9f8359d4f44f79a8f80909d9734fa3c38ef79ce4c307600dc)
# splits train-clean-100 train-clean-360 train-other-500; preset S; --device cuda --threads 4; --max-steps 8000
budget_s=750.0
max_batch=160
ddp_global_batches=true
optimizer=adamw
lr=0.0002476
warmup=200
total_steps=8000
min_lr_ratio=0.1212
rnnt_pieces=500
ctc_pieces=500
tokenizer=$D/models/zipformer-en-2023-06-26/bpe.model
clip=5.0
specaug_start=0
speed_perturb=0.9,1.0,1.1
rnnt_loss=pruned
prune_range=5
prune_warmup=0
prune_hold=0
ema_decay=0.9995
qkv_cap_from=100
qkv_cap_ratio=1.5
qkv_guard_ratio=2.0
diverge_after=1000
eval_every=0
eval_each_epoch=false
ckpt_every_steps=1000
weights_every=1000
log_every=25
loader=process
workers=12
window_groups=16
chunk_modes=4,8,16
delay_penalty=0.005
ddp_util_target=0.87
