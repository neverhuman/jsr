+"""Gradient-noise telemetry under data parallelism (frontier spec OPT-1.1; H50).
+
+Per parameter group j, rank r holds its own gradient contribution g_r before the all-reduce and
+the average g after it. One extra all-reduce of one float per group gives mean_r |g_r^j|^2, and
+with K contributing ranks:
+
+    tr Cov_j = K / (K - 1) * (mean_r |g_r^j|^2 - |g^j|^2)    (unbiased over ranks)
+    noise_j  = tr Cov_j / K                                   (variance of the averaged step gradient)
+    signal_j = |g^j|^2 - noise_j                              (unbiased |E g^j|^2)
+
+The trainer scales each rank's loss by world * N_r / N (token weights), so g_r is the rank's actual
+contribution and g is exactly their mean. A zero-support rank contributes 0: it is left out and the
+K active contributions are rescaled by K / world so that their mean is again g.
+
+Single steps are noisy (a difference of two large numbers), so the trainer logs sums over each log
+interval; read ratios over windows of a few hundred steps. Telemetry only: it never changes the
+gradients, so a run with gns_every > 0 is bit-identical to the same run without it.
+"""
+from __future__ import annotations
+
+import torch
+import torch.distributed as dist
+
+
+def group_name(param_name: str) -> str:
+    """stem; each encoder block; the other encoder parameters; predictor; joiner; CTC head; the
+    simple-joiner heads together (the spec's groups); any other top-level module by its name."""
+    p = param_name.split(".")
+    if p[0] == "encoder" and len(p) > 1:
+        if len(p) > 2 and p[1] in ("blocks", "layers") and p[2].isdigit():
+            return f"encoder.{p[1]}.{p[2]}"
+        return "encoder.stem" if p[1] == "stem" else "encoder.other"
+    if p[0].startswith("simple_"):
+        return "simple"
+    return p[0]
+
+
+def estimate(sum_local: torch.Tensor, g2: torch.Tensor, k: float, world: int):
+    """(signal, noise) per group from the all-reduced sum of local |g_r|^2 over the k contributing
+    ranks (out of `world`) and |g|^2 of the averaged gradient. None when fewer than 2 contribute."""
+    if k < 2:
+        return None
+    mean_local = sum_local * (k / world) ** 2 / k
+    noise = (k / (k - 1) * (mean_local - g2)) / k
+    return g2 - noise, noise
+
+
+class GnsState:
+    """Per-group accumulator of this rank's local squared gradient norms for one armed step."""
+
+    def __init__(self, model: torch.nn.Module, device):
+        self.names: list[str] = []
+        self.index: dict[int, int] = {}
+        for n, prm in model.named_parameters():
+            if not prm.requires_grad:
+                continue
+            g = group_name(n)
+            if g not in self.names:
+                self.names.append(g)
+            self.index[id(prm)] = self.names.index(g)
+        self.acc = torch.zeros(len(self.names), dtype=torch.float64, device=device)
+        self.armed = False
+
+    def begin(self) -> None:
+        self.acc.zero_()
+        self.armed = True
+
+    def add(self, params, grads) -> None:
+        pairs = [(self.index[id(p)], g) for p, g in zip(params, grads, strict=True)
+                 if g is not None and id(p) in self.index]
+        if not pairs:
+            return
+        idx = torch.tensor([i for i, _ in pairs], device=self.acc.device)
+        norms = torch._foreach_norm([g.float() for _, g in pairs])
+        self.acc.index_add_(0, idx, torch.stack(norms).double().to(self.acc.device) ** 2)
+
+    def global_sq(self, model: torch.nn.Module) -> torch.Tensor:
+        params = [p for p in model.parameters() if p.grad is not None and id(p) in self.index]
+        g2 = torch.zeros_like(self.acc)
+        if params:
+            idx = torch.tensor([self.index[id(p)] for p in params], device=self.acc.device)
+            norms = torch._foreach_norm([p.grad.float() for p in params])
+            g2.index_add_(0, idx, torch.stack(norms).double().to(self.acc.device) ** 2)
+        return g2
+
+    def finish(self, model: torch.nn.Module, active: bool, world: int):
+        """After the gradient all-reduce: ONE collective (local sums + active flag), then the
+        estimate. Every rank must call it at the same steps. Returns (signal, noise, k) or None."""
+        self.armed = False
+        t = torch.cat([self.acc * float(active), self.acc.new_tensor([float(active)])])
+        dist.all_reduce(t)
+        k = float(t[-1])
+        est = estimate(t[:-1], self.global_sq(model), k, world)
+        if est is None:
+            return None
+        return est[0], est[1], k
+
+
+def gns_hook(bf16: bool):
+    """DDP comm hook: on an armed step, add this rank's bucket gradients (still local) to the
+    accumulator, then reduce exactly as the plain (or bf16-compressed) default hook does."""
+    from torch.distributed.algorithms.ddp_comm_hooks import default_hooks
+
+    inner = default_hooks.bf16_compress_hook if bf16 else default_hooks.allreduce_hook
+
+    def hook(state: GnsState, bucket):
+        if state.armed:
+            state.add(bucket.parameters(), bucket.gradients())
+        return inner(None, bucket)
+
+    return hook
+
+
+class GnsTelemetry:
+    """The trainer-facing side: hook registration, arming every `every` steps, the per-step record
+    and interval sums for the log record (all sums, then reset at each log)."""
+
+    def __init__(self, model: torch.nn.Module, device, every: int):
+        self.state, self.every, self.tokens, self.log = GnsState(model, device), every, 0.0, None
+
+    def register(self, ddp, bf16: bool) -> None:
+        ddp.register_comm_hook(self.state, gns_hook(bf16))
+
+    def arm(self, step: int) -> bool:
+        if step % self.every:
+            return False
+        self.state.begin()
+        return True
+
+    def add_local(self, params) -> None:
+        self.state.add(params, [p.grad for p in params])
+
+    def finish(self, model: torch.nn.Module, active: bool, world: int) -> None:
+        est = self.state.finish(model, active, world)
+        if est is None:
+            return
+        signal, noise, _ = est
+        if self.log is None:
+            self.log = {"steps": 0, "signal": torch.zeros_like(signal), "noise": torch.zeros_like(noise),
+                        "noise_tokens": 0.0}
+        self.log["steps"] += 1
+        self.log["signal"] += signal
+        self.log["noise"] += noise
+        self.log["noise_tokens"] += float(noise.sum()) * self.tokens
+
+    def fields(self) -> dict:
+        """Interval sums; b_simple_tokens = sum(noise * tokens) / sum(signal) estimates
+        tr(Sigma_token) / |E g|^2 in transducer tokens."""
+        log, self.log = self.log, None
+        if not log:
+            return {}
+        sig, noi = log["signal"].tolist(), log["noise"].tolist()
+        tot_s, tot_n = sum(sig), sum(noi)
+        return {"gns_steps": log["steps"], "gns_signal": tot_s, "gns_noise": tot_n,
+                "gns_snr": tot_s / tot_n if tot_n > 0 else None,
+                "gns_b_simple_tokens": log["noise_tokens"] / tot_s if tot_s > 0 else None,
+                "gns_groups": {n: [a, b] for n, a, b in zip(self.state.names, sig, noi, strict=True)}}
+
+
+def maybe(model: torch.nn.Module, device, every: int, world: int) -> GnsTelemetry | None:
+    """Telemetry for a data-parallel run with gns_every > 0, else None (the default path)."""
+    return GnsTelemetry(model, device, every) if world > 1 and every > 0 else None
