+def _trainer_worker(rank, world, port, run_dir, out, native, gns):
+    os.environ.update(MASTER_ADDR="127.0.0.1", MASTER_PORT=str(port), RANK=str(rank), WORLD_SIZE=str(world))
+    torch.set_num_threads(1)
+    import torch.distributed as dist
+
+    dist.init_process_group("gloo")
+    torch.manual_seed(0)
+    t = _tiny_trainer(os.path.join(run_dir, f"r{rank}"), log_every=2, ddp_native=native, gns_every=gns)
+    from train.dist import broadcast_state
+
+    broadcast_state(t.model)
+    t.run(max_steps=4)
+    if rank == 0:
+        torch.save(t.model.state_dict(), out)
+    dist.destroy_process_group()
+
