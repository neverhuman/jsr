+def test_island_reads_exactly_its_ddp_rank_share(shard):
+    for world in (2, 3):
+        for r in range(world):
+            ddp = _src(shard, r, world, ddp_global_batches=True, budget_s=8.0)
+            island = _src(shard, 0, 1, budget_s=8.0)
+            apply_data_shard(island, TrainConfig(data_rank=r, data_world=world), world=1)
+            for w in range(ddp._windows(0)):
+                a = [([e.uid for e in g], act) for g, act in ddp._load_window(0, w)]
+                b = [([e.uid for e in g], act) for g, act in island._load_window(0, w)]
+                assert a == b
+    s = _src(shard)
+    apply_data_shard(s, TrainConfig(), world=1)  # data_world 0: untouched
+    assert (s.rank, s.world, s.ddp_global_batches) == (0, 1, False)
+    for bad, world in ((TrainConfig(data_rank=0, data_world=2), 2), (TrainConfig(data_rank=2, data_world=2), 1),
+                       (TrainConfig(data_rank=0, data_world=2, ddp_rank_weights="1,1"), 1)):
+        with pytest.raises(ValueError):
+            apply_data_shard(_src(shard), bad, world)
