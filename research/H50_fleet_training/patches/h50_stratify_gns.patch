+def test_loader_duration_strata_keep_the_window_groups(shard):
+    for world in (2, 3):
+        plain = [_src(shard, r, world) for r in range(world)]
+        strat = [_src(shard, r, world, stratify_lengths=True) for r in range(world)]
+        for w in range(plain[0]._windows(0)):
+            a = sorted(tuple(e.uid for e in g) for s in plain for g in s._load_window(0, w))
+            b = sorted(tuple(e.uid for e in g) for s in strat for g in s._load_window(0, w))
+            assert a == b  # same groups (incl. the repeated tail) per window, only re-dealt
+            n = [len(s._load_window(0, w)) for s in strat]
+            assert len(set(n)) == 1  # equal step count on every rank
