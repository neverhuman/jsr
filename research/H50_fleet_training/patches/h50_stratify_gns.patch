+def _tiny_trainer(d, **kw):
+    sys.path.insert(0, os.path.dirname(__file__))
+    from test_train_checkpoint import _cfg, _examples
+
+    base = _cfg()
+    mcfg = dataclasses.replace(base, encoder=dataclasses.replace(base.encoder, dropout=0.0))
+    cfg = TrainConfig(preset="TINY", warmup=2, total_steps=100, ckpt_every_steps=1000, ckpt_every_minutes=1e9,
+                      eval_every=0, log_every=kw.pop("log_every", 1000), specaug=False, clip=1.0, **kw)
+    src = FixedBatches(_examples(12, seed=3), batch_size=2, shuffle=False)
+    return Trainer(d, cfg, src, model_cfg=mcfg, device="cpu", log=False,
+                   rank=int(os.environ.get("RANK", 0)), world=int(os.environ.get("WORLD_SIZE", 1)),
+                   local_rank=int(os.environ.get("RANK", 0)))
