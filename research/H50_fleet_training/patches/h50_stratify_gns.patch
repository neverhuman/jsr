+@pytest.mark.parametrize("world,k", [(4, 4), (5, 4), (2, 2)])
+def test_estimator_is_unbiased_with_and_without_zero_support_ranks(world, k):
+    g = torch.Generator().manual_seed(world * 10 + k)
+    dim, sigma = 40, 0.5
+    mu = torch.randn(dim, generator=g, dtype=torch.float64)
+    sig_sum = noi_sum = 0.0
+    trials = 6000
+    for _ in range(trials):
+        h = mu + sigma * torch.randn(k, dim, generator=g, dtype=torch.float64)  # active contributions
+        contrib = h * (world / k)  # what the token-weighted loss hands DDP (zero-support ranks: 0)
+        mean = contrib.sum(0) / world
+        s, n = estimate(torch.tensor([float((contrib ** 2).sum())]), torch.tensor([float(mean @ mean)]),
+                        float(k), world)
+        sig_sum += float(s[0])
+        noi_sum += float(n[0])
+    assert abs(sig_sum / trials - float(mu @ mu)) < 0.05 * float(mu @ mu)
+    assert abs(noi_sum / trials - dim * sigma ** 2 / k) < 0.05 * dim * sigma ** 2 / k
+    assert estimate(torch.ones(1), torch.ones(1), 1.0, world) is None
+
