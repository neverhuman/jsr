+"""H50 trainer options: DiLoCo island data shards, per-rank chunk stratification (OPT-2.1), duration
+stratification of per-rank batches (OPT-2.2) and gradient-noise telemetry (OPT-1.1).
+
+Defaults change nothing; an island reads exactly its DDP rank's share; telemetry never changes the
+update (a run with it is bit-identical to the run without it)."""
+import dataclasses
+import io
+import json
+import os
+import socket
+import sys
+from types import SimpleNamespace
+
+import numpy as np
+import pyarrow as pa
+import pyarrow.parquet as pq
+import pytest
+import soundfile as sf
+import torch
+import torch.multiprocessing as mp
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+from train.data import Featurizer, FixedBatches, ParquetBatches, apply_data_shard, collate, stratified_parts  # noqa: E402
+from train.gns import GnsState, estimate, gns_hook, group_name  # noqa: E402
+from train.tokenizer import Tokenizer  # noqa: E402
+from train.trainer import TrainConfig, Trainer  # noqa: E402
+
+
+def _free_port() -> int:
+    with socket.socket() as s:
+        s.bind(("127.0.0.1", 0))
+        return s.getsockname()[1]
+
+
+# ---- OPT-2.1 chunk stratification ------------------------------------------------------------------
+def _chunks(steps, modes="4,8,16", stratify=False, data_rank=0, data_world=1, seed=1234):
+    cfg = TrainConfig(chunk_modes=modes, stratify_chunks=stratify, seed=seed)
+    fake = SimpleNamespace(cfg=cfg, data_rank=data_rank, data_world=data_world, step=0)
+    out = []
+    for s in range(steps):
+        fake.step = s
+        out.append(Trainer._step_chunk(fake))
+    return out
+
+
+def test_chunk_stratification_keeps_rank0_and_world1_and_spreads_modes():
+    base = _chunks(60)
+    modes = [int(v) for v in "4,8,16".split(",")]
+    pick = [modes[int(torch.randint(0, 3, (1,), generator=torch.Generator().manual_seed(
+        1234 * 1_000_003 + s + 500_009)))] for s in range(60)]
+    assert base == pick  # off = today's per-step draw, bit for bit
+    assert _chunks(60, stratify=True) == base  # world 1: unchanged
+    assert _chunks(60, stratify=True, data_rank=0, data_world=3) == base  # rank 0 keeps the draw
+    ranks = [_chunks(60, stratify=True, data_rank=r, data_world=3) for r in range(3)]
+    assert all(sorted(col) == [4, 8, 16] for col in zip(*ranks))  # every step averages all modes
+    two = [_chunks(60, stratify=True, data_rank=r, data_world=2) for r in range(2)]
+    assert all(a != b for a, b in zip(*two))
+    assert not dataclasses.asdict(TrainConfig())["stratify_chunks"]
+
+
+# ---- OPT-2.2 duration strata for per-rank batches --------------------------------------------------
+def test_stratified_parts_use_every_group_once_and_span_all_strata_each_step():
+    rng = np.random.default_rng(0)
+    dur = list(rng.uniform(1.0, 20.0, 240))
+    order = sorted(range(240), key=lambda i: dur[i])
+    groups = [order[i:i + 5] for i in range(0, 240, 5)]  # 48 duration-homogeneous groups
+    for world in (2, 3, 4, 6):
+        parts = [stratified_parts(groups, dur, world, r, [7, 0, 3]) for r in range(world)]
+        flat = sorted(tuple(g) for p in parts for g in p)
+        assert flat == sorted(tuple(g) for g in groups)  # same groups, each exactly once
+        per = len(groups) // world
+        longest = sorted(range(len(groups)), key=lambda k: (max(dur[i] for i in groups[k]), k))
+        stratum = {tuple(groups[k]): j // per for j, k in enumerate(longest)}
+        for i in range(per):  # one group from every stratum at every step
+            assert sorted(stratum[tuple(parts[r][i])] for r in range(world)) == list(range(world))
+        for r in range(world):  # every rank cycles through the strata
+            assert {stratum[tuple(g)] for g in parts[r][:world]} == set(range(world))
+        assert parts == [stratified_parts(groups, dur, world, r, [7, 0, 3]) for r in range(world)]
+    with pytest.raises(Exception):
+        stratified_parts(groups[:7], dur, 2, 0, [1])
+
+
+@pytest.fixture(scope="module")
+def shard(tmp_path_factory):
