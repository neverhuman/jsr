+def _hook_worker(rank, world, port, out):
+    os.environ.update(MASTER_ADDR="127.0.0.1", MASTER_PORT=str(port), RANK=str(rank), WORLD_SIZE=str(world))
+    torch.set_num_threads(1)
+    import torch.distributed as dist
+    from torch.nn.parallel import DistributedDataParallel
+
+    dist.init_process_group("gloo")
+    torch.manual_seed(0)
+    model = torch.nn.Sequential(torch.nn.Linear(8, 16), torch.nn.Tanh(), torch.nn.Linear(16, 3))
+    ref = torch.nn.Sequential(torch.nn.Linear(8, 16), torch.nn.Tanh(), torch.nn.Linear(16, 3))
+    ref.load_state_dict(model.state_dict())
+    x = torch.randn(6, 8, generator=torch.Generator().manual_seed(100 + rank))
+    y = torch.randn(6, 3, generator=torch.Generator().manual_seed(200 + rank))
+    ((ref(x) - y) ** 2).mean().backward()  # this rank's local gradient, no DDP
+    local = [p.grad.clone() for p in ref.parameters()]
+    st = GnsState(model, "cpu")
+    ddp = DistributedDataParallel(model, bucket_cap_mb=0.0001)  # several buckets
+    ddp.register_comm_hook(st, gns_hook(False))
+    st.begin()
+    ((ddp(x) - y) ** 2).mean().backward()
+    acc = st.acc.clone()
+    signal, noise, k = st.finish(model, True, world)
+    gathered = [None] * world
+    dist.all_gather_object(gathered, local)
+    if rank == 0:
+        torch.save({"acc": acc, "signal": signal, "noise": noise, "k": k, "local": gathered,
+                    "synced": [p.grad.clone() for p in model.parameters()], "names": st.names}, out)
+    dist.destroy_process_group()
+
+
+def test_hook_sees_local_gradients_and_estimates_from_one_collective(tmp_path):
+    out = str(tmp_path / "gns.pt")
+    mp.spawn(_hook_worker, args=(2, _free_port(), out), nprocs=2, join=True)
+    r = torch.load(out)
+    assert r["names"] == ["0", "2"] and r["k"] == 2.0
+    grp = [0, 0, 1, 1]  # weight, bias of layer "0"; weight, bias of layer "2"
+    local_sq = torch.zeros(2, dtype=torch.float64)
+    for gr, gt in zip(grp, r["local"][0], strict=True):
+        local_sq[gr] += float(gt.double().pow(2).sum())
+    assert torch.allclose(r["acc"], local_sq, rtol=1e-5)  # rank 0's own pre-reduction gradient
+    mean = [(a + b) / 2 for a, b in zip(r["local"][0], r["local"][1], strict=True)]
+    for m, s in zip(mean, r["synced"], strict=True):
+        assert torch.allclose(m, s, atol=1e-6)  # the hook still averaged the gradients
+    sum_local = torch.zeros(2, dtype=torch.float64)
+    g2 = torch.zeros(2, dtype=torch.float64)
+    for gr, a, b, m in zip(grp, r["local"][0], r["local"][1], mean, strict=True):
+        sum_local[gr] += float(a.double().pow(2).sum() + b.double().pow(2).sum())
+        g2[gr] += float(m.double().pow(2).sum())
+    s_ref, n_ref = estimate(sum_local, g2, 2.0, 2)
+    assert torch.allclose(r["signal"], s_ref, rtol=1e-4) and torch.allclose(r["noise"], n_ref, rtol=1e-4)
+
