{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neverhuman/jsr/contracts/events/receipt.v1.schema.json",
  "title": "ultra.receipt/v1",
  "description": "Run receipt (spec Appendix D). Source of truth: crates/ultra-core/src/receipt.rs; checked by crates/ultra-core/tests/schema_contract.rs. Receipt::validate_as_evidence refuses nulls where measurements belong.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle", "source_commit", "hardware", "target", "configured_threads", "cpu_only_verified", "audio_seconds", "chunk_ms", "status_events", "gaps", "hashes", "label", "partition", "completion_status"],
  "properties": {
    "schema": {"const": "ultra.receipt/v1"},
    "bundle": {"type": "string"},
    "source_commit": {"type": "string"},
    "hardware": {"type": "string"},
    "target": {"type": "string"},
    "configured_threads": {"type": "integer", "minimum": 1},
    "observed_threads": {"type": ["integer", "null"], "minimum": 0},
    "cpu_only_verified": {"type": "boolean"},
    "audio_seconds": {"type": "number"},
    "process_tree_cpu_seconds": {"type": ["number", "null"]},
    "peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
    "events": {"type": ["integer", "null"], "minimum": 0},
    "wakeups": {"type": ["integer", "null"], "minimum": 0},
    "cap_hits": {"type": ["integer", "null"], "minimum": 0},
    "chunk_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50", "p95", "p99"],
      "properties": {
        "p50": {"type": ["number", "null"]},
        "p95": {"type": ["number", "null"]},
        "p99": {"type": ["number", "null"]}
      }
    },
    "status_events": {"type": "array", "items": {"type": "string"}},
    "gaps": {
      "type": "array",
      "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}}
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "preview", "commit", "final"],
      "properties": {
        "events": {"type": "string"},
        "preview": {"type": "string"},
        "commit": {"type": "string"},
        "final": {"type": "string"}
      }
    },
    "label": {"enum": ["fair", "in-corpus", "recall", "unknown-overlap"]},
    "partition": {"enum": ["TRAIN", "CALIBRATION", "DEV", "CONFIRM", "PUBLIC-TEST", "DOMAIN-SEALED", "ADAPT-TEST", "PARITY"]},
    "completion_status": {"type": "string"}
  }
}
